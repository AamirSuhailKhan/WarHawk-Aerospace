{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "server.js": {
      "includeFiles": [
        "*.html",
        "styles.css",
        "script.js",
        "contact-form.js",
        "robots.txt",
        "sitemap.xml",
        "assets/**"
      ]
    },
    "api/*.js": {
      "includeFiles": [
        "*.html",
        "styles.css",
        "script.js",
        "contact-form.js",
        "robots.txt",
        "sitemap.xml",
        "assets/**"
      ]
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
