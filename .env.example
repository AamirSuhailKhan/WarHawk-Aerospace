# ==============================================================================
# WARHAWK AEROSPACE — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network & Runtime
PORT=5173
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration (PostgreSQL)
# When configured, Warhawk connects via connection pooling ('pg').
# If omitted or offline, falls back to durable local JSON store.
DATABASE_URL=postgresql://postgres:your_secure_password@your-postgres-host:5432/warhawk_db?sslmode=require
DATABASE_SSL=true
DB_POOL_MAX=10

# Admin Portal Security & Initial Account
# The operator console is accessible at /admin.
# Set a strong, unique password for production.
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=ChangeThisSecretKeyInProduction2026!

# Transactional Email Notification (Resend)
# Obtain your API key at https://resend.com and verify your sending domain (e.g. warhawk.aero).
EMAIL_API_KEY=re_your_live_resend_api_key
CONTACT_FROM_EMAIL="Warhawk Aerospace <inquiries@warhawk.aero>"
CONTACT_NOTIFY_EMAIL=operations@warhawk.aero
CONTACT_SEND_CONFIRMATION=true

# Security & Anti-Abuse Controls
RATE_LIMIT_MAX=8
